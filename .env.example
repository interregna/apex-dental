# Documentation only: dotnet does not automatically load this file.
# Set these in the shell/service environment. Never commit populated values.
OD_DB_SERVER=127.0.0.1
OD_DB_NAME=opendental
OD_DB_USER=replace-with-database-user
OD_DB_PASSWORD=replace-with-a-unique-password
ASPNETCORE_URLS=http://127.0.0.1:5080
# Dictation engine: local (default, audio stays on this host) or service.
TRANSCRIPTION_ENGINE=local
WHISPER_URL=http://127.0.0.1:8771
# External transcription API (sends audio off-host). Use only with
# TRANSCRIPTION_ENGINE=service; both values are then required.
# Service mode requires HTTPS, even for loopback addresses.
# TRANSCRIPTION_SERVICE_URL=https://transcription.example.invalid
# TRANSCRIPTION_SERVICE_TOKEN=replace-with-service-token
# Demo seeding remains disabled by default. Only use with synthetic databases.
# OD_ENABLE_DEMO_SEED=true
# OD_DEMO_PASSWORD=replace-with-at-least-12-characters

# Optional capabilities: each is disabled until enabled separately.
# Configure each service account at its provider; use a distinct scoped token.
APEX_MAIL_ENABLED=false
# APEX_MAIL_URL=https://mail.example.invalid
# APEX_MAIL_TOKEN=replace-with-mail-token
APEX_STORAGE_ENABLED=false
# APEX_STORAGE_URL=https://storage.example.invalid
# APEX_STORAGE_TOKEN=replace-with-storage-token
# APEX_STORAGE_ROOT=/
APEX_TRANSFER_ENABLED=false
# APEX_TRANSFER_URL=https://transfer.example.invalid
# APEX_TRANSFER_TOKEN=replace-with-transfer-token
APEX_TAX_ENABLED=false
# APEX_TAX_URL=https://tax.example.invalid
# APEX_TAX_TOKEN=replace-with-tax-token
