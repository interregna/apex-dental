<!-- Modified for the Apex Dental public source snapshot, 2026-10-25; see NOTICE. -->
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless Linux port of the Open Dental business layer.
       Compiles the unmodified upstream sources from CodeBase, DataConnectionBase,
       and OpenDentBusiness on cross-platform .NET 10. Windows-only files are
       removed via Excluded.items; shallow WinForms symbols are satisfied by
       Shims/. See RUNNING-LINUX-VM.md and OPTION-C-INVESTIGATION.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <WarningLevel>0</WarningLevel>
    <NoWarn>CS0618;CS0612;CS1701;NU1701;MSB3277</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Assembly identity must match upstream: several prebuilt DLLs in "Required dlls/"
         expose types from "OpenDentBusiness, Version=24.3.63.0" in their signatures, and
         the compiler unifies those references with this compilation only if the name and
         version line up. -->
    <AssemblyName>OpenDentBusiness</AssemblyName>
    <AssemblyVersion>24.3.63.0</AssemblyVersion>
    <RootNamespace>OpenDentBusiness</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Required to compile the resx (which holds binary entries) on .NET SDK/Linux. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Shims/**/*.cs" />
    <Compile Include="../OpenDentBusiness/Properties/Resources.Designer.cs" />
    <Compile Include="../OpenDentBusiness/Properties/Settings.Designer.cs" />
    <!-- Internal sheet defs (statements, Rx, consent forms...) live in this resx. -->
    <EmbeddedResource Include="../OpenDentBusiness/Properties/Resources.resx">
      <LogicalName>OpenDentBusiness.Properties.Resources.resources</LogicalName>
    </EmbeddedResource>
    <!-- Projected tooth anatomy outlines (see Tools/project_tooth_meshes.py). -->
    <EmbeddedResource Include="Shims/ToothChartPort/ToothAnatomy.json">
      <LogicalName>OpenDentBusinessCore.ToothAnatomy.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="Sources.items" />
  <Import Project="Excluded.items" />
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <PackageReference Include="PDFsharp" Version="6.5.0" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.14" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <!-- Advance transitive minimums to the current .NET 10 servicing release. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude DLLs whose simple names collide with NuGet packages or the .NET 10
         runtime: a duplicate simple name in the trusted-assembly list makes CoreCLR
         fail at startup with 0x80070057. The NuGet/runtime versions win. -->
    <Reference Include="../Required dlls/Bridges.dll" />
    <Reference Include="../Required dlls/CDT.dll" />
    <Reference Include="../Required dlls/Dicom.Core.dll" />
    <Reference Include="../Required dlls/Health.Direct.Agent.dll" />
    <Reference Include="../Required dlls/Health.Direct.Common.dll" />
    <Reference Include="../Required dlls/Health.Direct.ResolverPlugins.dll" />
    <Reference Include="../Required dlls/Interop.Microsoft.Office.Core.dll" />
    <Reference Include="../Required dlls/Interop.VBIDE.dll" />
    <Reference Include="../Required dlls/Interop.Word.dll" />
    <Reference Include="../Required dlls/ODCrypt.dll" />
    <Reference Include="../Required dlls/RS232.dll" />
    <Reference Include="../Required dlls/VBbridges.dll" />
    <Reference Include="../Required dlls/VirtualWeb.dll" />
    <Reference Include="../Required dlls/stdole.dll" />
  </ItemGroup>
</Project>
